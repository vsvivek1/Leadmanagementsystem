# Copy to .env and fill in. Restart the app after changes.

# gmail | outlook | zoho | custom
EMAIL_PROVIDER=gmail
EMAIL_ADDRESS=you@yourschoolbusiness.com
# Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
EMAIL_PASSWORD=
SENDER_NAME=Vivek

# Only needed for EMAIL_PROVIDER=custom (or to override the presets)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_FOLDER=INBOX

# Scheduling
SEND_EVERY_MINUTES=30
REPLY_CHECK_MINUTES=10
SEND_HOURS=9-18
TIMEZONE=Asia/Kolkata

# Protect the dashboard with a password (browser login prompt; any username). Leave empty for local-only use.
APP_PASSWORD=

# Where data is stored
# LEADAPP_DB=data/leads.db
